<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- TLS only; no cleartext anywhere (design §6.4). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Certificate/public-key pinning for the GitHub OTA endpoint (design §6.4). Pinned to the
         DigiCert roots GitHub chains to, with an expiration so a pin rotation degrades gracefully
         to system trust rather than bricking updates. -->
    <domain-config>
        <domain includeSubdomains="true">api.github.com</domain>
        <domain includeSubdomains="true">github.com</domain>
        <!-- Verified live 2026-09: api.github.com chains to Sectigo. Pin the Sectigo root +
             intermediate, with a DigiCert root as a fallback in case GitHub rotates CA, and an
             expiration so pinning degrades to system trust rather than bricking updates. -->
        <pin-set expiration="2026-12-31">
            <!-- Sectigo Public Server Authentication Root E46 -->
            <pin digest="SHA-256">sLVjNUaFYfW7n6EtgBeEpjOlcnBdNPMrZDRF36iwBdE=</pin>
            <!-- Sectigo Public Server Authentication CA DV E36 (intermediate) -->
            <pin digest="SHA-256">ZSagvDzjltLkewXEBuDxIzpW/dpVw1Juvvmd0hhkzdY=</pin>
            <!-- DigiCert Global Root G2 (fallback if GitHub switches CA) -->
            <pin digest="SHA-256">i7WTqTvh0OioIruIfFR4kMPnBqrS2rdiVPl/s2uC/CY=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
